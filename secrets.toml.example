# PLANTILLA. Copia este contenido en .streamlit/secrets.toml (local)
# y en Settings > Secrets de Streamlit Community Cloud (producción).
# NO subas el archivo real a GitHub.

[firebase]
# Abre el .json que descargaste de Firebase, copia TODO su contenido
# y pégalo entre las tres comillas simples, sin modificar nada.
service_account_json = '''
{
  "type": "service_account",
  "project_id": "TU-PROYECTO-FICTICIO",
  "private_key_id": "XXXXXXXX",
  "private_key": "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-xxxxx@TU-PROYECTO-FICTICIO.iam.gserviceaccount.com",
  "client_id": "000000000000000000000",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/xxxxx",
  "universe_domain": "googleapis.com"
}
'''

[postgres]
host = "pg-xxxxxxx-tuusuario-xxxx.l.aivencloud.com"
port = 12345
dbname = "guests"
user = "avnadmin"
password = "TU-CONTRASEÑA-FICTICIA"
